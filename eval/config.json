{
  "_comment": "Flight-check config: 1 OpenAI model + 1 OpenRouter model. Anthropic excluded.",
  "models": [
    {
      "name": "gpt-4o-mini",
      "baseUrl": "https://api.openai.com/v1",
      "apiKeyEnv": "OPENAI_API_KEY",
      "temperature": 0,
      "maxTokens": 4096
    },
    {
      "name": "meta-llama/llama-3.1-8b-instruct",
      "baseUrl": "https://openrouter.ai/api/v1",
      "apiKeyEnv": "OPENROUTER_API_KEY",
      "extraHeaders": {
        "HTTP-Referer": "https://github.com/tonguetoquill/quillmark-mcp",
        "X-Title": "quillmark-mcp eval"
      },
      "temperature": 0,
      "maxTokens": 4096
    }
  ]
}
