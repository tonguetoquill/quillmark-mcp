// Build a styled SVG string for a given path + color.
#let svg-of(path-d, color) = _svg(path-d, color.to-hex())

// Render as an image box at the given size.
#let icon(path-d, size: 16pt, color: rgb("#8B98A5")) = {
  box(
    width: size,
    height: size,
    image(bytes(svg-of(path-d, color)), width: size, height: size, format: "svg"),
  )
}
